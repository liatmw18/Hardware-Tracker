# .streamlit/secrets.toml
# This file stores the Snowflake service account credentials.
# DO NOT commit this file to GitHub. Add it via Streamlit Cloud's Secrets UI.

[snowflake]
account = "whoop-prod"
user = "YOUR_SERVICE_ACCOUNT_USER"
password = "YOUR_SERVICE_ACCOUNT_PASSWORD"
role = "WHOOP_LABS_ROLE"
warehouse = "WHOOP_LABS_WH"
database = "SCRATCH"
schema = "HARDWARE_TRACKER"
